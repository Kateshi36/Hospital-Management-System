<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DPI awareness: each monitor's own scaling (fixes drop-down lists opening away from their box).
         ApplicationConfiguration.Initialize() in Program.cs applies this. Forms use AutoScaleMode = Dpi. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The .exe / taskbar icon. Uses Assets\app.ico when it exists (see Assets\README.txt). -->
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Database\" />
    <!-- Run automatically at start-up on an older database (see Helpers\SchemaUpgrader.cs). -->
    <EmbeddedResource Include="Database\upgrade_v2.sql" />
    <EmbeddedResource Include="Database\upgrade_v3.sql" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Hospital logo (login screen, main header, window icon). Copied next to the .exe. -->
    <None Update="Assets\**\*.png;Assets\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>